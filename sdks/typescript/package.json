{
  "name": "@imbios/forgecode-sdk",
  "description": "Official TypeScript SDK for integrating with ForgeCode AI agent CLI. Provides async-generator streaming API, session management, MCP server integration, and Zod schema validation for AI-powered applications.",
  "version": "0.1.0",
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "typescript": "^6.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "keywords": [
    "ai-agent",
    "ai-sdk",
    "anthropic-claude",
    "async-generator",
    "claude-agent",
    "cli-automation",
    "code-automation",
    "developer-tools",
    "forgecode",
    "llm-integration",
    "mcp-client",
    "mcp-sdk",
    "model-context-protocol",
    "openai-alternative",
    "streaming-api",
    "typescript-sdk"
  ],
  "main": "src/index.ts",
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "private": true,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json"
  },
  "type": "module",
  "types": "src/index.ts"
}
